# ==============================================================================
# 🚀 FB PAGE BM AUTOMATED - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your real Meta Graph & Marketing API credentials.
# If left blank, the system automatically runs in high-fidelity SIMULATION MODE
# allowing 100% offline testing, training in Colab, and dashboard exploration.
# ==============================================================================

# Meta App & Access Credentials
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FB_PAGE_ID=act_page_khmer_quant
FB_AD_ACCOUNT_ID=act_10023456789
FB_BUSINESS_ID=biz_987654321
META_API_VERSION=v20.0

# Simulation / Mock Mode Override (Set to true to force simulation mode)
FB_MOCK_MODE=false

# Telegram Super Smart Bot Controller
BM_TELEGRAM_BOT_TOKEN=
BM_TELEGRAM_ADMIN_ID=859271875
BM_TELEGRAM_ALERTS=true

# Auto-Boost Rules & Thresholds
MIN_VIRAL_SCORE=70.0
MIN_PREDICTED_ROAS=2.20
MIN_HOOK_QUALITY=60.0
TEST_DAILY_BUDGET_USD=5.0
MAX_DAILY_BUDGET_USD=50.0
MAX_ACTIVE_BOOSTS=5
STOP_LOSS_ROAS=1.20
SCAN_INTERVAL_SECONDS=300

# Web Dashboard Port
BM_WEB_PORT=8088
BM_WEB_HOST=0.0.0.0

