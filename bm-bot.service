[Unit]
Description=Angkor Quant - FB Page BM Automated Telegram Bot Controller (24/7 LIVE)
After=network.target

[Service]
Type=simple
User=hemsoknitha
WorkingDirectory=/home/hemsoknitha/bm-automated
EnvironmentFile=-/home/hemsoknitha/bm-automated/.env
Environment=PYTHONIOENCODING=utf-8
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
ExecStart=/home/hemsoknitha/bm-automated/venv/bin/python3 bm_telegram_bot.py
Restart=always
RestartSec=10

Nice=15
MemoryMax=512M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

