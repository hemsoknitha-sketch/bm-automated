[Unit]
Description=Angkor Quant - FB Page BM Automated Web GUI Dashboard (Port 8088)
After=network.target

[Service]
Type=simple
User=hemsoknitha
WorkingDirectory=/home/hemsoknitha/BM_AUTOMATED
EnvironmentFile=-/home/hemsoknitha/BM_AUTOMATED/.env
Environment=PYTHONIOENCODING=utf-8
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
ExecStart=/home/hemsoknitha/BM_AUTOMATED/venv/bin/python3 web_dashboard.py
Restart=always
RestartSec=10

Nice=15
MemoryMax=512M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

