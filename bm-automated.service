[Unit]
Description=Angkor Quant - FB Page BM Automated Daemon 24/7 (AI Auto-Boost & Ad Optimization)
After=network.target

[Service]
Type=simple
User=hemsoknitha
WorkingDirectory=/home/hemsoknitha/bm-automated
EnvironmentFile=-/home/hemsoknitha/bm-automated/.env
Environment=PYTHONIOENCODING=utf-8
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
ExecStart=/home/hemsoknitha/bm-automated/venv/bin/python3 run_bm_automated.py --daemon --interval 300
Restart=always
RestartSec=10

# Scheduling Priority: Low priority (Nice=15) so VPS remains responsive
Nice=15

# Memory Clamping: Max 1.0 GB RAM to protect VPS stability
MemoryMax=1024M

# Standard logging via journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

